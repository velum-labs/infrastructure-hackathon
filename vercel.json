    {
      "source": "/en",
      "destination": "/"
    },
    {
      "source": "/en/",
      "destination": "/"
    },
    {
      "source": "/es",
      "destination": "/"
    },
    {
      "source": "/es/",
      "destination": "/"
    },
    {
      "source": "/home",
      "destination": "/"
    },
    {
      "source": "/home/",
      "destination": "/"
    },
    {
      "source": "/en/home",
      "destination": "/"
    },
    {
      "source": "/en/home/",
      "destination": "/"
    },
    {
      "source": "/es/home",
      "destination": "/"
    },
    {
      "source": "/es/home/",
      "destination": "/"
    },
    {
      "source": "/apply",
      "destination": "/"
    },
    {
      "source": "/apply/",
      "destination": "/"
    },
    {
      "source": "/sponsor",
      "destination": "/"
    },
    {
      "source": "/sponsor/",
      "destination": "/"
    },
    {
      "source": "/en/apply",
      "destination": "/"
    },
    {
      "source": "/en/apply/",
      "destination": "/"
    },
    {
      "source": "/es/apply",
      "destination": "/"
    },
    {
      "source": "/es/apply/",
      "destination": "/"
    }
  ]
}
